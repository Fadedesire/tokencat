{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenCat",
  "version": "0.9.1",
  "identifier": "app.tokencat.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TokenCat",
        "url": "index.html",
        "width": 252,
        "height": 80,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-background-networking --disable-component-update"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "publisher": "TokenCat",
    "shortDescription": "Limit tracker for Claude (unofficial)",
    "copyright": "TokenCat. Not affiliated with Anthropic.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "homepage": "https://github.com/Fadedesire/tokencat",
    "longDescription": "TokenCat shows how much of your Claude subscription limits (5-hour and weekly) is used and when they reset. Unofficial, not affiliated with Anthropic.",
    "category": "Utility",
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNjAxN0NFNkZFOUQ5NUEKUldSYTJlbHZ6aGRnSHR1WlR3Ym1rdzZ3WWhnRnVWY0FteGo5Z20yWk5zNENrU0tYWEIrYUFVZG0K",
      "endpoints": [
        "https://github.com/Fadedesire/tokencat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
