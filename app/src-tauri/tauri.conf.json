{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenCat",
  "version": "0.1.0",
  "identifier": "app.tokencat.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TokenCat",
        "width": 420,
        "height": 420,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "publisher": "TokenCat",
    "shortDescription": "Трекер лимитов для Claude (неофициальный)",
    "copyright": "TokenCat. Не связано с Anthropic.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
