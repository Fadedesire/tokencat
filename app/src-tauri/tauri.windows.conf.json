{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian",
          "Spanish",
          "PortugueseBR",
          "German",
          "French",
          "Japanese",
          "Korean",
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
